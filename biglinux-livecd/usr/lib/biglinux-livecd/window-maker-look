#!/usr/bin/env bash
# shellcheck shell=bash
#
# The Window Maker look for the installer windows, sourced by
# calamares-biglinux, which runs as root.
#
# In a Big WindowMaker session every GTK window has the OneStepBack theme and
# the window manager's title bar (the session preloads gtk-nocsd, which turns
# off the header bar GTK draws itself), and every Qt window a QTStep Kvantum
# theme. calamares-biglinux_polkit crosses into root with env -i, so it passes
# on only the names it read in the session: BIGLINUX_BIG_WM=1,
# BIGLINUX_GTK_THEME, BIGLINUX_GTK_NOCSD=1 and BIGLINUX_KVANTUM_THEME. Each one
# is checked again here against what is installed, and only these fixed
# values reach the environment of the installer's windows. Outside Big
# WindowMaker none of this applies and the installer looks as it always did.

# Fixed here, never taken from the environment (tests change them after
# sourcing this file).
big_wm_themes_directory=/usr/share/themes
big_wm_kvantum_directory=/usr/share/Kvantum
big_wm_nocsd_library=/usr/lib/libgtk-nocsd.so.0
big_wm_library_owner=0
# The Big WindowMaker default, for a session whose Kvantum file still names
# a theme from another desktop.
big_wm_default_kvantum_theme=QTStepOpenStep

big_wm_session() {
	[[ ${BIGLINUX_BIG_WM:-} == 1 ]]
}

# GTK theme name, with an optional variant (OneStepBack:dark), when that
# theme is installed with GTK 4 support, which the installer dialogs use.
big_wm_gtk_theme() {
	local theme=${BIGLINUX_GTK_THEME:-}
	big_wm_session || return 1
	[[ $theme =~ ^[A-Za-z0-9_.+-]+(:[a-z]+)?$ ]] || return 1
	[[ -d $big_wm_themes_directory/${theme%%:*}/gtk-4.0 ]] || return 1
	printf '%s\n' "$theme"
}

# gtk-nocsd only from its packaged path: a regular root-owned file nobody
# else can write. The value of the user's LD_PRELOAD never crosses over.
big_wm_nocsd() {
	local library=$big_wm_nocsd_library
	big_wm_session && [[ ${BIGLINUX_GTK_NOCSD:-} == 1 ]] || return 1
	[[ -f $library && ! -L $library ]] || return 1
	[[ $(stat -c '%u' -- "$library" 2>/dev/null) == "$big_wm_library_owner" ]] || return 1
	[[ -z $(find "$library" -maxdepth 0 -perm /022 2>/dev/null) ]] || return 1
	printf '%s\n' "$library"
}

big_wm_kvantum_theme_installed() {
	[[ $1 =~ ^[A-Za-z0-9_.+-]+$ && -f $big_wm_kvantum_directory/$1/$1.kvconfig ]]
}

# The user's Kvantum theme. The BigLinux themes (BigAdwaitaRound*) are what
# the other desktops write there, not a Window Maker choice: those and an
# unknown name fall back to the QTStep default.
big_wm_kvantum_theme() {
	local theme=${BIGLINUX_KVANTUM_THEME:-}
	big_wm_session || return 1
	if [[ $theme != BigAdwaitaRound* ]] && big_wm_kvantum_theme_installed "$theme"; then
		printf '%s\n' "$theme"
	elif big_wm_kvantum_theme_installed "$big_wm_default_kvantum_theme"; then
		printf '%s\n' "$big_wm_default_kvantum_theme"
	else
		return 1
	fi
}

# A KDE color scheme (kdeglobals) with the colors of a Kvantum theme, on
# stdout. Calamares runs with the KDE platform theme and the org.kde.desktop
# QtQuick style, which take every color from kdeglobals; with only the Kvantum
# theme in root's config they fell back to Breeze's light scheme, and on the
# dark QTStep theme the QML pages showed dark text over Kvantum's dark
# surfaces. Secondary text, links and the error/warning/success colors are
# derived for the theme's own background so they keep a 4.5:1 contrast.
big_wm_kdeglobals() {
	local theme=$1
	big_wm_kvantum_theme_installed "$theme" || return 1
	awk -v name="$theme" '
	function hex(s,  i, v, d) { v = 0; s = tolower(s)
		for (i = 1; i <= length(s); i++) { d = index("0123456789abcdef", substr(s, i, 1)); if (!d) return -1; v = v * 16 + d - 1 }
		return v }
	# "#rrggbb[aa]" -> "r,g,b", alpha blended over the window color
	function rgb(key, fallback,  c, a, r, g, b) {
		c = (key in col) ? col[key] : fallback
		if (c !~ /^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$/) c = fallback
		r = hex(substr(c, 2, 2)); g = hex(substr(c, 4, 2)); b = hex(substr(c, 6, 2))
		a = length(c) == 9 ? hex(substr(c, 8, 2)) / 255 : 1
		if (a < 1) { r = r * a + wr * (1 - a); g = g * a + wg * (1 - a); b = b * a + wb * (1 - a) }
		return sprintf("%d,%d,%d", r + 0.5, g + 0.5, b + 0.5) }
	function mix(fg, bg, t,  f, k) { split(fg, f, ","); split(bg, k, ",")
		return sprintf("%d,%d,%d", f[1] * t + k[1] * (1 - t) + 0.5, f[2] * t + k[2] * (1 - t) + 0.5, f[3] * t + k[3] * (1 - t) + 0.5) }
	function group(title, bg, alt, fg) {
		printf "[Colors:%s]\nBackgroundNormal=%s\nBackgroundAlternate=%s\n", title, bg, alt
		printf "ForegroundNormal=%s\nForegroundActive=%s\nForegroundInactive=%s\n", fg, fg, mix(fg, bg, 0.72)
		printf "ForegroundLink=%s\nForegroundVisited=%s\n", link, visited
		printf "ForegroundNegative=%s\nForegroundNeutral=%s\nForegroundPositive=%s\n", negative, neutral, positive
		printf "DecorationFocus=%s\nDecorationHover=%s\n\n", focus, hover }
	/^\[/ { in_colors = ($0 == "[GeneralColors]"); next }
	in_colors && /=/ { k = $0; sub(/=.*/, "", k); v = $0; sub(/^[^=]*=/, "", v); gsub(/[[:space:]]/, "", k); gsub(/[[:space:]]/, "", v); col[k] = v }
	END {
		wr = wg = wb = 170
		window = rgb("window.color", "#aaaaaa"); split(window, w, ","); wr = w[1]; wg = w[2]; wb = w[3]
		dark = (0.2126 * wr + 0.7152 * wg + 0.0722 * wb) < 128
		text = rgb("text.color", dark ? "#e6e6e6" : "#000000")
		window_text = rgb("window.text.color", text)
		base = rgb("base.color", window); alt = rgb("alt.base.color", base)
		button = rgb("button.color", window); button_text = rgb("button.text.color", text)
		selection = rgb("highlight.color", dark ? "#a8a8a8" : "#ffffff")
		selection_text = rgb("highlight.text.color", "#000000")
		tooltip = rgb("tooltip.base.color", base); tooltip_text = rgb("tooltip.text.color", text)
		if (dark) { link = "138,180,248"; visited = "197,138,249"; negative = "255,138,128"; neutral = "255,204,128"; positive = "129,199,132" }
		else { link = "0,47,135"; visited = "75,0,130"; negative = "122,0,0"; neutral = "77,48,0"; positive = "0,64,0" }
		focus = window_text; hover = rgb("light.color", selection)
		printf "[General]\nColorScheme=%s\n\n", name
		group("Window", window, window, window_text)
		group("View", base, alt, text)
		group("Button", button, button, button_text)
		group("Selection", selection, selection, selection_text)
		group("Tooltip", tooltip, tooltip, tooltip_text)
		group("Header", window, window, window_text)
		group("Complementary", window, window, window_text)
	}' "$big_wm_kvantum_directory/$theme/$theme.kvconfig"
}

# Environment for the GTK windows (dialogs and the installer launcher), as
# NAME=value words in the big_wm_gtk_environment array.
big_wm_set_gtk_environment() {
	local value
	big_wm_gtk_environment=()
	# Tells the installer windows to stay opaque like every other Window
	# Maker window (their translucent background is a Plasma/GNOME touch).
	big_wm_session && big_wm_gtk_environment+=("BIGLINUX_WINDOW_MAKER=1")
	if value=$(big_wm_gtk_theme); then
		big_wm_gtk_environment+=("GTK_THEME=$value")
	fi
	if value=$(big_wm_nocsd); then
		big_wm_gtk_environment+=("LD_PRELOAD=$value")
	fi
	return 0
}
